    <res-ref-name>jdbc/UsuariosDB</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>-->
  <resource-ref>
    <description>DataSource para UsuariosDB</description>
    <res-ref-name>jdbc/PlatformData</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>
  
</web-app>
